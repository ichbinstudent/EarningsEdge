[Unit]
Description=Earnings Edge Trading Bot (Telegram)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=david
Group=david
WorkingDirectory=/home/david/EarningsEdgeDetection
ExecStart=/home/david/EarningsEdgeDetection/.venv/bin/python3.12 bot.py
Restart=on-failure
RestartSec=10
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=-/home/david/EarningsEdgeDetection/.env

NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/david/EarningsEdgeDetection/data /home/david/EarningsEdgeDetection/logs
PrivateTmp=true

[Install]
WantedBy=multi-user.target
