[Unit]
Description=Earnings Edge German crash alerts
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/david/EarningsEdgeDetection/cli_scanner
ExecStart=/home/david/EarningsEdgeDetection/cli_scanner/.venv/bin/python3.12 crash_alert.py
Restart=always
RestartSec=10
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=-/home/david/EarningsEdgeDetection/cli_scanner/.env

NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/david/EarningsEdgeDetection/cli_scanner/data /home/david/EarningsEdgeDetection/cli_scanner/logs
PrivateTmp=true

[Install]
WantedBy=default.target
